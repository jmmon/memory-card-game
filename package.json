{
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808",
  "name": "memory-card-game",
  "description": "Match all pairs to clear the board!",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.clean": "rm -rf ./dist && rm -rf ./server && pnpm run lint:fix; pnpm run build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy-clean:master": "git checkout cloudflare-master && pnpm run build.clean && pnpm run deploy:master",
    "deploy-clean:stage": "git checkout cloudflare-stage && pnpm run build.clean && pnpm run deploy:stage",
    "deploy:master": "wrangler pages deploy ./dist --branch=cloudflare-master",
    "deploy:stage": "wrangler pages deploy ./dist --branch=cloudflare-stage",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "drizzle:stage:update": "drizzle-kit generate --config=./drizzle-dev.config.ts",
    "drizzle:master:update": "drizzle-kit generate --config=./drizzle-prod.config.ts",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "preview": "qwik build preview && pnpm vite preview --open",
    "serve": "branch=$(git branch --show-current); echo \"* *\"; echo \" *  Running on branch $branch  *\"; echo \"* *\" && wrangler pages dev ./dist --compatibility-flags=nodejs_als",
    "serve.clean": "rm -rf ./dist && rm -rf ./server && pnpm run lint:fix; pnpm run build; pnpm run serve",
    "start": "vite --open --mode ssr",
    "test.unit": "vitest components",
    "test.unit.ui": "vitest --ui components",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.17",
    "@builder.io/qwik-city": "^1.17",
    "@cloudflare/workers-types": "^4.20250705.0",
    "@eslint/js": "latest",
    "@qwik-ui/headless": "^0.6.7",
    "@types/compression": "^1.7.2",
    "@types/eslint": "8.56.10",
    "@types/node": "20.19.0",
    "@vitest/ui": "^0.34.6",
    "autoprefixer": "^10.4.14",
    "compression": "^1.7.4",
    "dotenv": "^16.3.2",
    "drizzle-kit": "^0.30.6",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.17",
    "globals": "16.3.0",
    "node-env-run": "^4.0.2",
    "postcss": "^8.4.31",
    "postcss-nesting": "^13.0.2",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.4",
    "rollup": "4.52.0",
    "tailwindcss": "3.3.3",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vite": "7.1.7",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^0.34.6",
    "wrangler": "^4.44.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.41.0",
    "jabber": "^1.5.3",
    "zod": "^3.22.4"
  }
}
